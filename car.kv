#:kivy 2.0

<HomeScreen>:
    canvas.before:
        Color:
            rgba: 0.071, 0.071, 0.071, 1  # #121212
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [70, 60, 70, 40]

        # Clock block
        AnchorLayout:
            size_hint_y: 0.62
            anchor_x: 'center'
            anchor_y: 'center'

            BoxLayout:
                orientation: 'vertical'
                size_hint: None, None
                size: self.minimum_size
                spacing: 4

                BoxLayout:
                    orientation: 'horizontal'
                    size_hint: None, None
                    size: self.minimum_size

                    Label:
                        id: time_label
                        text: '--:--'
                        font_size: '108sp'
                        bold: True
                        color: 1, 1, 1, 1
                        size_hint: None, None
                        size: self.texture_size

                    BoxLayout:
                        orientation: 'vertical'
                        size_hint: None, None
                        width: 54
                        height: self.parent.height if self.parent else 130
                        padding: [10, 20, 0, 20]

                        Label:
                            id: ampm_label
                            text: '--'
                            font_size: '24sp'
                            color: 0.4, 0.4, 0.4, 1
                            halign: 'left'
                            valign: 'top'
                            text_size: self.size
                            size_hint_y: 0.45

                        Widget:
                            size_hint_y: 0.55

        # Date
        AnchorLayout:
            size_hint_y: 0.1
            anchor_x: 'center'
            anchor_y: 'center'

            Label:
                id: date_label
                text: '---'
                font_size: '22sp'
                color: 0.114, 0.725, 0.329, 1  # #1DB954 Spotify green

        Widget:
            size_hint_y: 0.06

        # Nav bar
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: 0.22
            spacing: 14

            Button:
                text: 'Music'
                font_size: '19sp'
                bold: True
                color: 1, 1, 1, 1
                background_normal: ''
                background_color: 0, 0, 0, 0
                canvas.before:
                    Color:
                        rgba: 0.114, 0.725, 0.329, 1  # green accent
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14]
                on_press: root.manager.current = 'music'

            Button:
                text: 'Map'
                font_size: '19sp'
                bold: True
                color: 0.7, 0.7, 0.7, 1
                background_normal: ''
                background_color: 0, 0, 0, 0
                canvas.before:
                    Color:
                        rgba: 0.13, 0.13, 0.13, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [14]
                on_press: root.manager.current = 'map'


<MusicScreen>:
    canvas.before:
        Color:
            rgba: 0.071, 0.071, 0.071, 1  # #121212
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: [50, 36, 50, 36]
        spacing: 0

        # Top bar
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 44

            Button:
                text: '< Home'
                font_size: '16sp'
                color: 0.4, 0.4, 0.4, 1
                background_normal: ''
                background_color: 0, 0, 0, 0
                size_hint_x: None
                width: 110
                on_press: root.manager.current = 'home'

            Widget:

        Widget:
            size_hint_y: None
            height: 48

        # Track title
        Label:
            id: title_label
            text: '---'
            font_size: '30sp'
            bold: True
            color: 1, 1, 1, 1
            halign: 'center'
            valign: 'middle'
            text_size: self.width, None
            size_hint_y: None
            height: 46

        Widget:
            size_hint_y: None
            height: 8

        # Artist
        Label:
            id: artist_label
            text: '---'
            font_size: '20sp'
            color: 0.702, 0.702, 0.702, 1  # #B3B3B3
            halign: 'center'
            valign: 'middle'
            text_size: self.width, None
            size_hint_y: None
            height: 34

        Widget:
            size_hint_y: None
            height: 6

        # Album
        Label:
            id: album_label
            text: ''
            font_size: '16sp'
            color: 0.325, 0.325, 0.325, 1  # #535353
            halign: 'center'
            valign: 'middle'
            text_size: self.width, None
            size_hint_y: None
            height: 26

        Widget:
            size_hint_y: None
            height: 20

        # Time labels
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 24

            Label:
                id: time_current
                text: '0:00'
                font_size: '14sp'
                color: 0.45, 0.45, 0.45, 1
                halign: 'left'
                text_size: self.size

            Label:
                id: time_total
                text: '0:00'
                font_size: '14sp'
                color: 0.45, 0.45, 0.45, 1
                halign: 'right'
                text_size: self.size

        Widget:
            size_hint_y: None
            height: 8

        # Progress bar
        BoxLayout:
            size_hint_y: None
            height: 10
            canvas.before:
                Color:
                    rgba: 0.22, 0.22, 0.22, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [3]

            Widget:
                id: progress_fill
                size_hint_x: 0
                canvas:
                    Color:
                        rgba: 0.114, 0.725, 0.329, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [3]

            Widget:

        Widget:
            size_hint_y: None
            height: 20

        # Volume row
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 44
            spacing: 12

            Button:
                text: '-'
                font_size: '22sp'
                bold: True
                color: 0.702, 0.702, 0.702, 1
                size_hint_x: None
                width: 44
                background_normal: ''
                background_color: 0, 0, 0, 0
                canvas.before:
                    Color:
                        rgba: 0.13, 0.13, 0.13, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                on_press: root.on_volume_down()

            BoxLayout:
                orientation: 'horizontal'
                spacing: 8

                Label:
                    text: 'VOL'
                    font_size: '12sp'
                    color: 0.35, 0.35, 0.35, 1
                    size_hint_x: None
                    width: 32
                    halign: 'left'
                    text_size: self.size
                    valign: 'middle'

                BoxLayout:
                    size_hint_y: None
                    height: 6
                    pos_hint: {'center_y': 0.5}
                    canvas.before:
                        Color:
                            rgba: 0.22, 0.22, 0.22, 1
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [3]
                    Widget:
                        id: volume_fill
                        size_hint_x: 0.8
                        canvas:
                            Color:
                                rgba: 0.114, 0.725, 0.329, 1
                            RoundedRectangle:
                                pos: self.pos
                                size: self.size
                                radius: [3]
                    Widget:

                Label:
                    id: volume_label
                    text: '--%'
                    font_size: '13sp'
                    color: 0.5, 0.5, 0.5, 1
                    size_hint_x: None
                    width: 40
                    halign: 'right'
                    text_size: self.size
                    valign: 'middle'

            Button:
                text: '+'
                font_size: '22sp'
                bold: True
                color: 0.702, 0.702, 0.702, 1
                size_hint_x: None
                width: 44
                background_normal: ''
                background_color: 0, 0, 0, 0
                canvas.before:
                    Color:
                        rgba: 0.13, 0.13, 0.13, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                on_press: root.on_volume_up()

        Widget:
            size_hint_y: None
            height: 12

        # Playback controls
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 84
            spacing: 18

            Button:
                background_normal: ''
                background_color: 0, 0, 0, 0
                canvas.before:
                    Color:
                        rgba: 0.13, 0.13, 0.13, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16]
                on_press: root.on_previous()
                Image:
                    id: prev_icon
                    source: 'assets/icons/prev.png'
                    size_hint: None, None
                    size: self.parent.width - 28, self.parent.height - 28
                    pos: self.parent.x + 14, self.parent.y + 14
                    fit_mode: 'contain'
                    mipmap: False

            Button:
                id: playpause_btn
                background_normal: ''
                background_color: 0, 0, 0, 0
                canvas.before:
                    Color:
                        rgba: 0.114, 0.725, 0.329, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16]
                on_press: root.on_playpause()
                Image:
                    id: playpause_icon
                    source: 'assets/icons/play.png'
                    size_hint: None, None
                    size: self.parent.width - 28, self.parent.height - 28
                    pos: self.parent.x + 14, self.parent.y + 14
                    fit_mode: 'contain'
                    mipmap: False

            Button:
                background_normal: ''
                background_color: 0, 0, 0, 0
                canvas.before:
                    Color:
                        rgba: 0.13, 0.13, 0.13, 1
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [16]
                on_press: root.on_next()
                Image:
                    id: next_icon
                    source: 'assets/icons/next.png'
                    size_hint: None, None
                    size: self.parent.width - 28, self.parent.height - 28
                    pos: self.parent.x + 14, self.parent.y + 14
                    fit_mode: 'contain'
                    mipmap: False

        Widget:
            size_hint_y: None
            height: 10


<MapScreen>:
    canvas.before:
        Color:
            rgba: 0.071, 0.071, 0.071, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: 'vertical'
        padding: 50
        spacing: 20

        Label:
            text: 'Map'
            font_size: '36sp'
            color: 1, 1, 1, 1

        Label:
            text: 'Coming soon'
            font_size: '20sp'
            color: 0.4, 0.4, 0.4, 1

        Widget:

        Button:
            text: 'Back'
            size_hint_y: None
            height: 60
            font_size: '18sp'
            background_normal: ''
            background_color: 0, 0, 0, 0
            canvas.before:
                Color:
                    rgba: 0.13, 0.13, 0.13, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [14]
            on_press: root.manager.current = 'home'
